# Server
PORT=8080

# Database
DATABASE_URL=postgres://shakedown:shakedown@db:5432/shakedown?sslmode=disable

# Storage
STORAGE_ROOT=/data/audio

# Auth - set to true to bypass OIDC for local development
DISABLE_AUTH=true

# OIDC (Pocket ID) - not required when DISABLE_AUTH=true
OIDC_ISSUER=https://your-pocket-id-instance.example.com
OIDC_CLIENT_ID=shakedown
OIDC_CLIENT_SECRET=your-client-secret
APP_BASE_URL=http://localhost:8080

# Admin - OIDC group name that grants admin privileges (optional)
# ADMIN_GROUP=shakedown-admins

# Session
SESSION_SECRET=change-this-to-a-random-32-byte-secret

# Processing
PROCESSING_MAX_WORKERS=4
PROCESSING_TIMEOUT_SECONDS=300

# Upload
UPLOAD_MAX_SIZE_MB=500

# Cloud sync (rclone) - disabled by default. rclone.conf is a SECRET; never commit it.
# Mount/create it at RCLONE_CONFIG (default /data/rclone/rclone.conf, under the /data bind mount).
# CLOUD_SYNC_ENABLED=false
# CLOUD_SYNC_RCLONE_BIN=rclone
# RCLONE_CONFIG=/data/rclone/rclone.conf
# CLOUD_SYNC_REMOTE=
# CLOUD_SYNC_ROOT=Shakedown
# CLOUD_SYNC_PATH_TEMPLATE={year}/{date}/{title}.{ext}
# CLOUD_SYNC_INTERVAL_SECONDS=3600
# CLOUD_SYNC_MAX_WORKERS=2
# CLOUD_SYNC_MAX_ATTEMPTS=5
# CLOUD_SYNC_LEASE_TTL_SECONDS=900
# CLOUD_SYNC_BACKOFF_BASE_SECONDS=60
# CLOUD_SYNC_TPS_LIMIT=0
